version: '3.8'

services:
# ============================================================
# KAFKA BROKER (KRaft, single-node, optimized for CDC)
# ============================================================
  kafka:
    image: confluentinc/cp-kafka:8.0.3
    container_name: cdc_kafka
    restart: unless-stopped
    ports:
      - "9092:9092"
      
    environment:
      # ---------------- KRaft ----------------
      KAFKA_PROCESS_ROLES: broker,controller
      KAFKA_NODE_ID: 1
      KAFKA_CONTROLLER_LISTENER_NAMES: CONTROLLER
      KAFKA_CONTROLLER_QUORUM_VOTERS: "1@kafka:29093"
      CLUSTER_ID: "9XewYwTmQR-rjrdndJ99pQ"

      # ---------------- Listeners ----------------
      KAFKA_LISTENERS: PLAINTEXT://0.0.0.0:9092,SASL_PLAINTEXT://0.0.0.0:9093,CONTROLLER://0.0.0.0:29093
      KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://kafka:9092,SASL_PLAINTEXT://kafka:9093
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: PLAINTEXT:PLAINTEXT,SASL_PLAINTEXT:SASL_PLAINTEXT,CONTROLLER:PLAINTEXT

      # ---------------- SASL Authentication ----------------
      KAFKA_SASL_ENABLED_MECHANISMS: PLAIN
      KAFKA_SASL_MECHANISM_INTER_BROKER_PROTOCOL: PLAIN
      KAFKA_OPTS: "-Djava.security.auth.login.config=/etc/kafka/jaas.config -Duser.timezone=UTC"
      KAFKA_SUPER_USERS: "User:admin;User:debezium"

      # ---------------- Replication (single node) ----------------
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_MIN_ISR: 1
      KAFKA_MIN_INSYNC_REPLICAS: 1

      # ---------------- PERFORMANCE TUNING ----------------
      KAFKA_NUM_NETWORK_THREADS: 8
      KAFKA_NUM_IO_THREADS: 16
      KAFKA_MESSAGE_MAX_BYTES: 10485760
      KAFKA_REPLICA_FETCH_MAX_BYTES: 10485760
      KAFKA_LOG_FLUSH_INTERVAL_MESSAGES: 10000
      KAFKA_LOG_FLUSH_INTERVAL_MS: 1000

    volumes:
      - "{{ debezium_base_dir }}/kafka-config/jaas.conf:/etc/kafka/jaas.config:ro"
      - "{{ debezium_base_dir }}/kafka-config/kafka_server_jaas.conf:/etc/kafka/kafka_server_jaas.conf:ro"

    networks:
      - cdc-debezium-network


# ============================================================
# KAFKA CONNECT (Debezium Worker, optimized producer)
# ============================================================
  debezium-connect:
    image: debezium/connect:2.7.3.Final
    container_name: cdc_debezium_connect
    restart: unless-stopped
    depends_on:
      - kafka

    # # ✅ TAMBAHAN PENTING (BIAR BISA DIAKSES)
    # ports:
    #   - "8083:8083"

    environment:
      # ---------------- Core ----------------
      BOOTSTRAP_SERVERS: kafka:9093
      GROUP_ID: debezium-connect-group

      CONFIG_STORAGE_TOPIC: debezium_connect_configs
      OFFSET_STORAGE_TOPIC: debezium_connect_offsets
      STATUS_STORAGE_TOPIC: debezium_connect_statuses

      CONNECT_REST_ADVERTISED_HOST_NAME: debezium-connect

      # ✅ TAMBAHAN (biar eksplisit)
      CONNECT_REST_PORT: 8083

      CONNECT_PLUGIN_PATH: /kafka/connect,/kafka/custom-connectors

      # ---------------- SASL Authentication for Kafka ----------------
      CONNECT_SECURITY_PROTOCOL: SASL_PLAINTEXT
      CONNECT_SASL_MECHANISM: PLAIN
      CONNECT_SASL_JAAS_CONFIG: 'org.apache.kafka.common.security.plain.PlainLoginModule required username="debezium" password="{{ debezium_kafka_debezium_password }}";'

      # ---------------- PRODUCER TUNING ----------------
      CONNECT_PRODUCER_BATCH_SIZE: 1048576
      CONNECT_PRODUCER_LINGER_MS: 50
      CONNECT_PRODUCER_BUFFER_MEMORY: 134217728
      CONNECT_PRODUCER_COMPRESSION_TYPE: lz4

      # ---------------- PRODUCER/CONSUMER SASL OVERRIDE ----------------
      CONNECT_PRODUCER_SECURITY_PROTOCOL: "SASL_PLAINTEXT"
      CONNECT_PRODUCER_SASL_MECHANISM: "PLAIN"
      CONNECT_PRODUCER_SASL_JAAS_CONFIG: 'org.apache.kafka.common.security.plain.PlainLoginModule required username="debezium" password="{{ debezium_kafka_debezium_password }}";'

      CONNECT_CONSUMER_SECURITY_PROTOCOL: "SASL_PLAINTEXT"
      CONNECT_CONSUMER_SASL_MECHANISM: "PLAIN"
      CONNECT_CONSUMER_SASL_JAAS_CONFIG: 'org.apache.kafka.common.security.plain.PlainLoginModule required username="debezium" password="{{ debezium_kafka_debezium_password }}";'

      # ---------------- JVM HEAP ----------------
      KAFKA_HEAP_OPTS: "-Xms2G -Xmx4G"

      # ---------------- Stability ----------------
      CONNECT_REST_MAX_THREADS: 50
      CONNECT_CONFIG_STORAGE_REPLICATION_FACTOR: 1
      CONNECT_OFFSET_STORAGE_REPLICATION_FACTOR: 1
      CONNECT_STATUS_STORAGE_REPLICATION_FACTOR: 1

      KAFKA_OPTS: "-Duser.timezone=UTC"

    volumes:
      - "{{ debezium_base_dir }}/debezium-connectors:/kafka/custom-connectors"

    deploy:
      resources:
        limits:
          cpus: "4.0"
        reservations:
          cpus: "2.0"

    networks:
      - cdc-debezium-network


# ============================================================
# KAFKA UI (Monitoring)
# ============================================================
  kafka-ui:
    image: provectuslabs/kafka-ui:v0.7.2
    container_name: cdc_kafka_ui
    restart: unless-stopped
    depends_on:
      - kafka

    # # ✅ TAMBAHAN (biar bisa diakses langsung kalau perlu)
    # ports:
    #   - "8080:8080"

    environment:
      KAFKA_CLUSTERS_0_NAME: local
      KAFKA_CLUSTERS_0_BOOTSTRAPSERVERS: kafka:9093
      KAFKA_CLUSTERS_0_ZOOKEEPER: ""

      KAFKA_CLUSTERS_0_PROPERTIES_SECURITY_PROTOCOL: SASL_PLAINTEXT
      KAFKA_CLUSTERS_0_PROPERTIES_SASL_MECHANISM: PLAIN
      KAFKA_CLUSTERS_0_PROPERTIES_SASL_JAAS_CONFIG: 'org.apache.kafka.common.security.plain.PlainLoginModule required username="admin" password="{{ debezium_kafka_admin_password }}";'

      KAFKA_UI_AUTH_DISABLED: "true"
      SPRING_SECURITY_USER_NAME: "admin"
      SPRING_SECURITY_USER_PASSWORD: "{{ debezium_kafka_ui_password }}"

    networks:
      - cdc-debezium-network


# ============================================================
# NGINX REVERSE PROXY (Authentication Layer)
# ============================================================
  nginx-auth:
    image: nginx:alpine
    container_name: cdc_nginx
    restart: unless-stopped
    depends_on:
      - debezium-connect
      - kafka-ui
    ports:
      - "9096:9096"
      - "9095:9095"
    volumes:
      - "{{ debezium_base_dir }}/nginx/nginx.conf:/etc/nginx/nginx.conf:ro"
      - "{{ debezium_base_dir }}/nginx/.htpasswd:/etc/nginx/.htpasswd:ro"
    networks:
      - cdc-debezium-network

networks:
  cdc-debezium-network:
    driver: bridge