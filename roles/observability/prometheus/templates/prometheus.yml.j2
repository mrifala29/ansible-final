global:
  scrape_interval: {{ prometheus_scrape_interval }}

scrape_configs:
  - job_name: "prometheus"
    static_configs:
      - targets:
{% for target in prometheus_targets.prometheus %}
          - "{{ target }}"
{% endfor %}

  - job_name: "node_exporter"
    static_configs:
      - targets:
{% for target in prometheus_targets.node_exporter %}
          - "{{ target }}"
{% endfor %}