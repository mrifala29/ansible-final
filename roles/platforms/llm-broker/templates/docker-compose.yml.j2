version: "3.9"

services:
  llm-broker:
    image: {{ llm_broker_image }}
    container_name: {{ llm_broker_container_name }}
    restart: always

    ports:
      - "{{ llm_broker_port_host }}:{{ llm_broker_port_container }}"

    volumes:
      - {{ llm_broker_config_file }}:/app/config.yaml

    command: >
      --config /app/config.yaml

    environment:
      - PYTHONUNBUFFERED=1