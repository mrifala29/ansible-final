version: "3.9"

services:
  seaweedfs:
    image: chrislusf/seaweedfs:{{ seaweedfs_version }}
    container_name: seaweedfs
    restart: always
    command: >-
      server
      -dir=/data
      -ip=0.0.0.0
      -master.port={{ seaweedfs_master_port }}
      -volume.port={{ seaweedfs_volume_port }}
      -filer=true
      -filer.port={{ seaweedfs_filer_port }}
      -s3=true
      -s3.port={{ seaweedfs_s3_port }}
      -s3.port.iceberg=0
      -s3.config=/etc/seaweedfs/s3.json
    environment:
      AWS_ACCESS_KEY_ID: ${AWS_ACCESS_KEY_ID}
      AWS_SECRET_ACCESS_KEY: ${AWS_SECRET_ACCESS_KEY}
    ports:
      - "{{ seaweedfs_master_port }}:{{ seaweedfs_master_port }}"
      - "{{ seaweedfs_volume_port }}:{{ seaweedfs_volume_port }}"
      - "{{ seaweedfs_filer_port }}:{{ seaweedfs_filer_port }}"
      - "{{ seaweedfs_s3_port }}:{{ seaweedfs_s3_port }}"
    volumes:
      - {{ seaweedfs_data_dir }}:/data
      - {{ seaweedfs_compose_dir }}/s3.json:/etc/seaweedfs/s3.json:ro
