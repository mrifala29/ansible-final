# YugabyteDB reference config (generated by Ansible, for documentation only)
# Internal container ports — do NOT mount this file into the container.
# yugabyted manages its own configuration via --master_flags / --tserver_flags.

cluster_name={{ yugabytedb_cluster_name }}

# External host ports (host:container mapping)
# master_webserver_port : {{ yugabytedb_master_port }}:7000   -> http://host:{{ yugabytedb_master_port }}
# tserver_webserver_port: {{ yugabytedb_tserver_port }}:9000  -> http://host:{{ yugabytedb_tserver_port }}
# ysql (postgres)       : {{ yugabytedb_ysql_port }}:5433     -> psql -h host -p {{ yugabytedb_ysql_port }}
# ycql (cassandra)      : {{ yugabytedb_yql_port }}:9042
# yugabyted UI          : 15433:15433                         -> http://host:15433