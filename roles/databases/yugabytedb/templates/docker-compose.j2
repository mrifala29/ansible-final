services:
  yugabytedb:
    image: yugabytedb/yugabyte:{{ yugabytedb_version }}
    container_name: yugabytedb
    command:
      - bin/yugabyted
      - start
      - --daemon=false
      - --ui=true
      - --callhome=false
      - --base_dir=/home/yugabyte/var
      # NOTE: JANGAN pass 'cluster_name' ke --master_flags. Flag itu TIDAK
      # dikenal yb-master di versi 2.21.x -> crash loop (unknown command line
      # flag 'cluster_name'). Identitas cluster ditangani otomatis oleh
      # yugabyted via --cluster_uuid. yugabyted juga otomatis mengisi
      # rpc_bind_addresses/webserver_interface dengan IP container.
      # Yang kita override hanya proxy bind address agar YSQL/YCQL bisa
      # diakses dari luar container (docker port mapping).
      - --tserver_flags=pgsql_proxy_bind_address=0.0.0.0:5433,cql_proxy_bind_address=0.0.0.0:9042
    ports:
      - "{{ yugabytedb_master_port }}:7000"
      - "{{ yugabytedb_tserver_port }}:9000"
      - "{{ yugabytedb_yql_port }}:9042"
      - "{{ yugabytedb_ysql_port }}:5433"
      - "15433:15433"
    volumes:
      - "{{ yugabytedb_data_dir }}:/home/yugabyte/var"
    ulimits:
      nofile:
        soft: 1048576
        hard: 1048576
      core:
        soft: -1
        hard: -1
    restart: unless-stopped